    <SCRIPT_CONTENT>
// dr2050 Looper Vocal Looper 1
Var
   V1button : Widget
   V1, V1input: PluginBlock;
 

On WidgetValueChanged(newValue : double) from V1button    
   Print(&quot;V1button value changed to: &quot; + newValue)
   // feedback to 50%
   SetParameter(V1, 16, newValue * 0.5)
   // mix to zero
   SetParameter(V1, 0, newValue * 0.5)
   // kill the input
   SetParameter(V1input, 4, newValue)
End

// dr2050 Looper Vocal Looper 2
Var
   V2button : Widget
   V2, V2input : PluginBlock;
 

On WidgetValueChanged(newValue : double) from V2button    
   Print(&quot;V2button value changed to: &quot; + newValue)
   // feedback to 50%
   SetParameter(V2, 16, newValue * 0.5)
   // mix to zero
   SetParameter(V2, 0, newValue * 0.5)
   // kill the input
   SetParameter(V2input, 4, newValue)
End
</SCRIPT_CONTENT>
  </RACKSPACE>
  <SETLISTS activeSetlist="0"/>
</GIGRACK>
