Var
   V1button, V2button   : Widget
   V1, V1input          : PluginBlock
   V2, V2input          : PluginBlock
   
Function HandleLooper1(buttonValue : double, looper : PluginBlock, looperInput : PluginBlock)
   // feedback to 100% (max is 200%)
   SetParameter(looper, 16, buttonValue * 0.5)

   // MIX: input-only OR wet only
   SetParameter(looper, 0, buttonValue)

   // kill the input
   SetParameter(looperInput, 4, buttonValue)
End

On WidgetValueChanged(newValue : double) from V1button
   HandleLooper1(newValue, V1, V1input)
End

On WidgetValueChanged(newValue : double) from V2button
   HandleLooper1(newValue, V2, V2input)
End

// ===============================
// dr2050 Post Loopers: Need to halt output when not looping
// ===============================

Var
   P1button, P2button   : Widget
   P1, P1input, P1output          : PluginBlock
   P2, P2input, P2output          : PluginBlock

Function HandleLooper2(buttonValue : double, looper : PluginBlock, looperInput : PluginBlock, looperOutput : PluginBlock)
   // feedback to 100% (max is 200%)
   SetParameter(looper, 16, buttonValue * 0.5)

   // kill the input
   SetParameter(looperInput, 4, buttonValue)
   
      // unmute the output
   SetParameter(looperOutput, 4, 1 - buttonValue)
End

On WidgetValueChanged(newValue : double) from P1button
   HandleLooper2(newValue, P1, P1input, P1output)
End

On WidgetValueChanged(newValue : double) from P2button
   HandleLooper2(newValue, P2, P2input, P2output)
End
</SCRIPT_CONTENT>
  </RACKSPACE>
  <SETLISTS activeSetlist="0"/>
</GIGRACK>
