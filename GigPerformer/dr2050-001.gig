      <PARAM widgetId="29" value="0.5984252095222473" onLoadValue="0.6296172142028809"/>
      <PARAM widgetId="36" value="0.0" onLoadValue="0.0"/>
      <PARAM widgetId="45" value="0.0" onLoadValue="0.0"/>
      <PARAM widgetId="46" value="0.220458984375" onLoadValue="0.0"/>
      <PARAM widgetId="47" value="0.220458984375" onLoadValue="0.453582763671875"/>
      <PARAM widgetId="48" value="0.0" onLoadValue="0.0"/>
      <PARAM widgetId="50" value="0.0" onLoadValue="0.5769062638282776"/>
      <PARAM widgetId="54" value="0.0" onLoadValue="0.6692913174629211"/>
    </PRESET>
    <SCRIPT_CONTENT>
// ===============================
// Shared looper behavior
// - Feedback to 100%
// - Kill looper input
// ===============================
Function SetCommonLooperParams(buttonValue : double, looper : PluginBlock, looperInput : PluginBlock)
   SetParameter(looper, 16, buttonValue * 0.5)   // feedback = 100%
   SetParameter(looperInput, 4, buttonValue)    // kill input
End


// ===============================
// dr2050 Vocal Loopers: Need to Change Mix
// ===============================

Var
   V1button, V2button   : Widget
   V1, V1input          : PluginBlock
   V2, V2input          : PluginBlock
   
Function HandleLooper1(buttonValue : double, looper : PluginBlock, looperInput : PluginBlock)
    SetCommonLooperParams(buttonValue, looper, looperInput)
    SetParameter(looper, 0, buttonValue) // MIX: input-only OR wet only
End

On WidgetValueChanged(newValue : double) from V1button
   HandleLooper1(newValue, V1, V1input)
End

On WidgetValueChanged(newValue : double) from V2button
   HandleLooper1(newValue, V2, V2input)
End

// ===============================
// dr2050 Post Loopers: Need to halt output when not looping
// ===============================

Var
   P1button, P2button   : Widget
   P1, P1input, P1output          : PluginBlock
   P2, P2input, P2output          : PluginBlock

Function HandleLooper2(buttonValue : double, looper : PluginBlock, looperInput : PluginBlock, looperOutput : PluginBlock)
    SetCommonLooperParams(buttonValue, looper, looperInput)
   
      // unmute the output
   SetParameter(looperOutput, 4, 1 - buttonValue)
End

On WidgetValueChanged(newValue : double) from P1button
   HandleLooper2(newValue, P1, P1input, P1output)
End

On WidgetValueChanged(newValue : double) from P2button
   HandleLooper2(newValue, P2, P2input, P2output)
End
</SCRIPT_CONTENT>
  </RACKSPACE>
  <SETLISTS activeSetlist="0"/>
</GIGRACK>
