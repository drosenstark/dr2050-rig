#N canvas 100 100 900 500 10;
#X obj 40 40 playhead;
#X obj 40 80 print playhead-raw;
#X obj 260 40 route tempo playing beat bar;
#X floatatom 260 90 10 0 0 0 tempo-bpm - - 0;
#X obj 260 130 expr 60000 / $f1;
#X floatatom 260 170 10 0 0 0 quarter-ms - - 0;
#X obj 260 210 print tempo-bpm;
#X obj 260 250 print quarter-ms;
#X floatatom 430 90 10 0 0 0 playing - - 0;
#X floatatom 540 90 10 0 0 0 beat - - 0;
#X floatatom 650 90 10 0 0 0 bar - - 0;
#X obj 430 130 print playing;
#X obj 540 130 print beat;
#X obj 650 130 print bar;
#X connect 0 0 1 0;
#X connect 0 0 2 0;
#X connect 2 0 3 0;
#X connect 2 0 6 0;
#X connect 2 0 4 0;
#X connect 2 1 8 0;
#X connect 2 1 11 0;
#X connect 2 2 9 0;
#X connect 2 2 12 0;
#X connect 2 3 10 0;
#X connect 2 3 13 0;
#X connect 4 0 5 0;
#X connect 4 0 7 0;
