#N canvas 100 100 1200 700 10;
#X obj 40 40 playhead;
#X obj 40 100 print playhead-out0;
#X obj 180 100 print playhead-out1;
#X obj 320 100 print playhead-out2;
#X obj 460 100 print playhead-out3;
#X obj 600 100 print playhead-out4;
#X obj 740 100 print playhead-out5;
#X obj 880 100 print playhead-out6;
#X obj 1020 100 print playhead-out7;
#X floatatom 40 180 10 0 0 0 out0 - - 0;
#X floatatom 180 180 10 0 0 0 out1 - - 0;
#X floatatom 320 180 10 0 0 0 out2 - - 0;
#X floatatom 460 180 10 0 0 0 out3 - - 0;
#X floatatom 600 180 10 0 0 0 out4 - - 0;
#X floatatom 740 180 10 0 0 0 out5 - - 0;
#X floatatom 880 180 10 0 0 0 out6 - - 0;
#X floatatom 1020 180 10 0 0 0 out7 - - 0;
#X obj 40 250 expr 60000 / $f1;
#X floatatom 40 290 10 0 0 0 quarter-ms-from-out1 - - 0;
#X obj 40 330 print quarter-ms-from-out1;
#X text 40 380 Reload this patch in the plugin and hit play in the host.;
#X text 40 405 Watch the console for which outlet tracks host tempo.;
#X text 40 430 If one outlet shows the actual BPM \, that is the one to use.;
#X connect 0 0 1 0;
#X connect 0 0 9 0;
#X connect 0 1 2 0;
#X connect 0 1 10 0;
#X connect 0 1 17 0;
#X connect 0 2 3 0;
#X connect 0 2 11 0;
#X connect 0 3 4 0;
#X connect 0 3 12 0;
#X connect 0 4 5 0;
#X connect 0 4 13 0;
#X connect 0 5 6 0;
#X connect 0 5 14 0;
#X connect 0 6 7 0;
#X connect 0 6 15 0;
#X connect 0 7 8 0;
#X connect 0 7 16 0;
#X connect 17 0 18 0;
#X connect 17 0 19 0;
